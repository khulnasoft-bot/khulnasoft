{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered platform developer or organization member",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user identifier from Auth" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "RepositoryNote": {
      "title": "Repository Note",
      "description": "User notes and internal operational bookmarks attached to catalog repositories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "repoId": { "type": "string" },
        "repoName": { "type": "string" },
        "userId": { "type": "string" },
        "note": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["todo", "in_review", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "repoId", "userId", "note"]
    },
    "AuditBookmark": {
      "title": "Audit Bookmark",
      "description": "Bookmarked repository discovery events or audit snapshots by logged in user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "repoId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/repositoryNotes/{noteId}": {
      "schema": { "$ref": "#/entities/RepositoryNote" },
      "description": "Repository notes created by authenticated developers"
    },
    "/auditBookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/AuditBookmark" },
      "description": "Saved bookmarks and notes"
    }
  }
}
