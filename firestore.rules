rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // Repository Notes collection
    match /repositoryNotes/{noteId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(noteId)
        && incoming().userId == request.auth.uid
        && incoming().note is string
        && incoming().note.size() <= 2000;
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().note is string
        && incoming().note.size() <= 2000;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Audit Bookmarks collection
    match /auditBookmarks/{bookmarkId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(bookmarkId)
        && incoming().userId == request.auth.uid
        && incoming().title is string
        && incoming().title.size() <= 200;
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
